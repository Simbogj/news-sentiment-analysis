    "    if len(subset) > 2:\n",
    "        r, p = stats.pearsonr(subset['avg_sentiment'], subset['daily_return'])\n",
    "        print(f\"  {symbol}: r={r:.4f}, p={p:.4e}, n={len(subset)}\")"
   ]
